# Log level (debug [default], info, warn, error)
LOG_LEVEL=debug

# Host and port [default: 127.0.0.1:20045]
HOST=127.0.0.1
PORT=20045

# Number of worker threads [default: 0 = double the number of CPUs]
WORKERS=0
# Maximum number of requests in queue [default: 100]
QUEUE_SIZE=100

# Enable URL signature verification [default: false]
SIGNATURE_ENABLED=false
# Signature secret key used for HMAC-SHA256 verification, for example run `openssl rand -hex 48` in terminal to generate a new random string
SIGNATURE_SECRET=

# CORS allowed origins [default: *]
CORS_ALLOWED_ORIGINS=*

# Enable libvips memory debugging
VIPS_DEBUG=false
# Number of libvips threads [default: 2]
VIPS_CONCURRENCY=2

# Data directory root, skipped from URL [default: data]
DATA_DIR=data
# Serve all files in data directory [default: false]
DATA_SERVE_ALL=false


#####
# Cache options
#####

# Cache directory [default: cache]
CACHE_DIR=cache

# Enable memory cache [default: true]
CACHE_MEMORY_ENABLED=true
# Maximum number of cache entries [default: 1000]
CACHE_MEMORY_CAPACITY=1000
# Maximum size of single cache entry in MB [default: 2]
CACHE_MEMORY_ENTRY_LIMIT=2

# Enable disk cache [default: true]
CACHE_DISK_ENABLED=true
# Maximum _effective_ size of disk cache in MB [default: 1024]
CACHE_DISK_LIMIT=1024


#####
# SVG loading options
# By default, libvips blocks loading SVG images larger than 10 MB to increase security.
#####

# Allow loading SVG images larger than 10 MB [default: false]
SVG_UNLIMITED=false
# SVG load DPI [default: 120]
SVG_LOAD_DPI=120



#####
# PDF loading options
#####

# PDF load DPI [default: 120]
PDF_LOAD_DPI=120


#####
# Office document conversion options
#####

# Timeout for office document conversion in seconds [default: 30]
OFFICE_CONVERSION_TIMEOUT=30


#####
# Image processing options
#####

# Automatically rotate image based on EXIF orientation tag [default: true]
IMAGE_EXIF_AUTO_ROTATE=true
# Enable image upsizing [default: false]
IMAGE_UPSIZE=false
# Enable image extending to fit aspect ratio (bg, copy, repeat, mirror) [default: bg]
IMAGE_EXTEND=bg
# Fit image to requested width and height (cover [default], contain, force)
IMAGE_FIT=cover
# Default gravity (top, right, bottom, left, top-left, top-right, bottom-left, bottom-right, center [default], attention, entropy)
IMAGE_GRAVITY=center
# Default cropping gravity (top, right, bottom, left, top-left, top-right, bottom-left, bottom-right, center [default], attention, entropy)
IMAGE_CROP_GRAVITY=center
# Image resampling algorithm (nearest, linear, cubic, lanczos2, lanczos3 [default])
IMAGE_RESAMPLE=lanczos3


#####
# Watermark options
#####

# Enable watermarking [default: false]
WATERMARK_ENABLED=false
# Watermark position (center, repeat, top, right, bottom, left, top-left, top-right, bottom-left, bottom-right [default])
WATERMARK_POSITION=bottom-right
# Watermark opacity [default: 50]
WATERMARK_OPACITY=50
# Watermark padding in px [default: 10]
WATERMARK_PADDING=10
# Watermark rotation in degrees [default: 0]
WATERMARK_ROTATE=0

# Watermark image path [default: ]
WATERMARK_IMAGE=
# Watermark image scale [default: 1]
WATERMARK_IMAGE_SCALE=1

# Watermark text [default: ]
WATERMARK_TEXT=
# Watermark font family [default: Arial]
WATERMARK_FONT_FAMILY=Arial
# Watermark font size in px [default: 12]
WATERMARK_FONT_SIZE=12
# Watermark font color [default: black]
WATERMARK_FONT_COLOR=black


#####
# Output options
#####

# Priority of output formats [default: jxl,avif,webp,jpeg,png]
OUTPUT_FORMAT_PRIORITY=jxl,avif,webp,jpeg,png
# Enable AVIF image output [default: true]
OUTPUT_ENABLE_AVIF=true
# Enable WEBP image output [default: true]
OUTPUT_ENABLE_WEBP=true
# Enable JPEG XL image output [default: true]
OUTPUT_ENABLE_JXL=true

# Metadata to keep in output images (none, icc, exif, xmp, iptc, other, gainmap, all) [default: none]
OUTPUT_METADATA=none
# Image quality (low, medium [default], high, maximum)
OUTPUT_QUALITY=medium
# Image processing effort (low, medium [default], high)
OUTPUT_EFFORT=medium
# Enable high bitdepth output [default: false]
OUTPUT_HIGH_BITDEPTH=false
# Enable CMYK output for CMYK images [default: false]
OUTPUT_CMYK=false
# Maximum output image width [default: 5000]
OUTPUT_MAX_WIDTH=5000
# Maximum output image height [default: 5000]
OUTPUT_MAX_HEIGHT=5000
# Maximum output image size [default: 0] (0 = unlimited); accepts a unit suffix, eg. 500K, 2M (1K = 1024 B)
OUTPUT_MAX_SIZE=0
# How close under the size limit is close enough, in percent [default: 10]
# An image between (limit - threshold%) and limit is accepted without another recompress.
OUTPUT_MAX_SIZE_THRESHOLD=10
# Maximum number of recompress attempts to fit the size limit [default: 3]
OUTPUT_MAX_SIZE_ATTEMPTS=3
# Quality floor for the recompress search, 1-100 [default: 10]
OUTPUT_MAX_SIZE_MIN_QUALITY=10


#####
# Quality curves
#
# Output quality is interpolated between MAX (small images) and MIN (large ones),
# then offset by the named `q` level. All five curves use the shared 1-100 quality
# domain, including JXL, which converts internally as distance = 0.15 * (100 - q)
# -- so JXL's numbers here will not match the JXL documentation's distances.
#####

# Megapixels at or above which quality bottoms out at MIN [default: 8.0]
OUTPUT_QUALITY_MIN_AREA=8.0
# Megapixels at or below which quality tops out at MAX [default: 0.25]
OUTPUT_QUALITY_MAX_AREA=0.25

# MIN and MAX are 1-100; LOW, HIGH and MAXIMUM are offsets applied for `q=low`,
# `q=high` and `q=maximum` (`q=medium` and `q=auto` apply no offset).
OUTPUT_QUALITY_JPEG_MIN=32
OUTPUT_QUALITY_JPEG_MAX=80
OUTPUT_QUALITY_JPEG_LOW=-12
OUTPUT_QUALITY_JPEG_HIGH=10
OUTPUT_QUALITY_JPEG_MAXIMUM=17

OUTPUT_QUALITY_WEBP_MIN=40
OUTPUT_QUALITY_WEBP_MAX=78
OUTPUT_QUALITY_WEBP_LOW=-10
OUTPUT_QUALITY_WEBP_HIGH=8
OUTPUT_QUALITY_WEBP_MAXIMUM=15

OUTPUT_QUALITY_AVIF_MIN=38
OUTPUT_QUALITY_AVIF_MAX=67
OUTPUT_QUALITY_AVIF_LOW=-10
OUTPUT_QUALITY_AVIF_HIGH=10
OUTPUT_QUALITY_AVIF_MAXIMUM=16

OUTPUT_QUALITY_PNG_MIN=32
OUTPUT_QUALITY_PNG_MAX=99
OUTPUT_QUALITY_PNG_LOW=-30
OUTPUT_QUALITY_PNG_HIGH=0
OUTPUT_QUALITY_PNG_MAXIMUM=1

# Equivalent to distances 5.0 (min) and 2.2 (max), offsets +1.5 / -0.67 / -1.75
OUTPUT_QUALITY_JXL_MIN=66.667
OUTPUT_QUALITY_JXL_MAX=85.333
OUTPUT_QUALITY_JXL_LOW=-10
OUTPUT_QUALITY_JXL_HIGH=4.467
OUTPUT_QUALITY_JXL_MAXIMUM=11.667


#####
# Encoder effort
#
# OUTPUT_EFFORT (above) picks the column; each codec grades effort on its own
# scale, so the levels are configured per format. Higher is slower and smaller.
# JPEG has no effort setting.
#####

# webp, range 0-6
OUTPUT_EFFORT_WEBP_LOW=0
OUTPUT_EFFORT_WEBP_MEDIUM=2
OUTPUT_EFFORT_WEBP_HIGH=4

# png, range 1-10
OUTPUT_EFFORT_PNG_LOW=1
OUTPUT_EFFORT_PNG_MEDIUM=2
OUTPUT_EFFORT_PNG_HIGH=5

# avif, range 0-9
OUTPUT_EFFORT_AVIF_LOW=0
OUTPUT_EFFORT_AVIF_MEDIUM=1
OUTPUT_EFFORT_AVIF_HIGH=4

# jxl, range 1-9
OUTPUT_EFFORT_JXL_LOW=1
OUTPUT_EFFORT_JXL_MEDIUM=3
OUTPUT_EFFORT_JXL_HIGH=6

# gif, range 1-10
OUTPUT_EFFORT_GIF_LOW=1
OUTPUT_EFFORT_GIF_MEDIUM=7
OUTPUT_EFFORT_GIF_HIGH=9


#####
# Per-encoder options
#####

# Optimise Huffman tables (slower, slightly smaller) [default: true]
OUTPUT_JPEG_OPTIMIZE_CODING=true

# Megapixels at or below which OUTPUT_WEBP_PRESET_SMALL is used [default: 0.25]
OUTPUT_WEBP_TEXT_PRESET_AREA=0.25
# Presets: default, picture, photo, drawing, icon, text
OUTPUT_WEBP_PRESET_SMALL=text
OUTPUT_WEBP_PRESET_LARGE=default
# Alpha is never encoded below this quality, 0-100 [default: 75]
OUTPUT_WEBP_MIN_ALPHA_QUALITY=75
OUTPUT_WEBP_SMART_SUBSAMPLE=true

# Quality at which PNG switches to the lossless (non-palette) branch [default: 100]
OUTPUT_PNG_LOSSLESS_QUALITY=100
# Deflate level, 0-9
OUTPUT_PNG_COMPRESSION=2
OUTPUT_PNG_LOSSLESS_COMPRESSION=3
# Quantisation dithering, 0-1
OUTPUT_PNG_DITHER=0.25
OUTPUT_PNG_LOSSLESS_DITHER=0.0

# 8, 10 or 12
OUTPUT_AVIF_BITDEPTH=8
# av1, hevc, avc, jpeg
OUTPUT_AVIF_COMPRESSION=av1
# aom, auto, rav1e, svt, x265
OUTPUT_AVIF_ENCODER=aom
# Chroma subsampling: auto, on, off
OUTPUT_AVIF_SUBSAMPLE=on

# Decode speed tier, 0-4 (higher decodes faster, compresses worse)
OUTPUT_JXL_TIER=0
OUTPUT_JXL_LOSSLESS=false
# JXL distance per shared quality point, distance = value * (100 - quality) [default: 0.15]
OUTPUT_JXL_DISTANCE_PER_QUALITY=0.15
